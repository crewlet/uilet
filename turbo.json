{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tokens/**",
        "stylesheets/**",
        "fonts/**",
        "svg/**",
        "symbols/**",
        "scripts/**",
        ".storybook/**",
        "package.json",
        "tsconfig.json",
        "tsup.config.*",
        "style-dictionary.config.*",
        "$TURBO_ROOT$/scripts/check-storybook-static.mjs"
      ],
      "outputs": [
        "dist/**",
        "src/generated/**",
        "build/**",
        "storybook-static/**",
        "src/index.ts",
        "src/themes.ts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "test/**", "package.json", "$TURBO_ROOT$/eslint.config.js"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "tsconfig.json", "vitest.config.*", "package.json", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "test/**", "tokens/**", "stylesheets/**", "symbols/**", "svg/**", "vitest.config.*", "package.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
