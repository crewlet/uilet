{
  "name": "uilet",
  "private": true,
  "type": "module",
  "description": "Crewlet design system: design tokens, signature icons, and React UI components.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && npm run lint:scripts",
    "lint:scripts": "eslint scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && npm run test:scripts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "storybook": "npm run dev --workspace @crewlethq/storybook",
    "release:check": "node scripts/release.mjs check",
    "release:version": "node scripts/release.mjs version",
    "release:pack": "node scripts/release.mjs pack"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "esbuild": "^0.28.2"
  }
}
