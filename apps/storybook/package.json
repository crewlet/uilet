{
  "name": "@crewlethq/storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 3006 --no-open --disable-telemetry",
    "build": "storybook build -o storybook-static --disable-telemetry && node scripts/write-font-licenses.mjs storybook-static && node ../../scripts/check-storybook-static.mjs storybook-static",
    "lint": "eslint src .storybook scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf storybook-static"
  },
  "dependencies": {
    "@crewlethq/icons": "0.2.0",
    "@crewlethq/tokens": "0.2.0",
    "@crewlethq/ui": "0.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "vite": "^8.3.0"
  }
}
