{
  "name": "@crewlethq/ui",
  "version": "0.2.0",
  "description": "Crewlet shared React components built on @crewlethq/tokens and @crewlethq/icons.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewlet/uilet.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/crewlet/uilet/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/crewlet/uilet/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/write-barrel.mjs && tsup && tsc -p tsconfig.build.json && node scripts/bundle-css.mjs",
    "dev": "node scripts/write-barrel.mjs && tsup --watch --onSuccess \"node scripts/bundle-css.mjs\"",
    "lint": "node scripts/write-barrel.mjs && eslint src scripts && node scripts/check-css-variables.mjs && node scripts/check-css-literals.mjs src",
    "typecheck": "node scripts/write-barrel.mjs && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@crewlethq/icons": "0.2.0",
    "@crewlethq/tokens": "0.2.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "uqr": "0.1.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "crewlet-css-check": "./scripts/check-css.mjs"
  }
}
