{
  "name": "@crewlethq/ui",
  "version": "0.2.0",
  "description": "Crewlet shared React components built on @crewlethq/tokens and @crewlethq/icons.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewlet/uilet.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/crewlet/uilet/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/crewlet/uilet/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/bundle-css.mjs",
    "dev": "tsup --watch --onSuccess \"node scripts/bundle-css.mjs\"",
    "lint": "eslint src scripts && node scripts/check-css-variables.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@crewlethq/icons": "0.2.0",
    "@crewlethq/tokens": "0.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.3.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
