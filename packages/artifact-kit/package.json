{
  "name": "@crewlethq/artifact-kit",
  "version": "0.2.0",
  "description": "The Crewlet design system as a framework-free browser bundle for artifact pages: the tokens, every theme, the fonts and the base stylesheet, an opt-in stylesheet for a page's plain HTML, the theme bootstrap, and the sheet as custom elements bound to the artifact runtime.",
  "license": "MIT AND OFL-1.1 AND ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewlet/uilet.git",
    "directory": "packages/artifact-kit"
  },
  "homepage": "https://github.com/crewlet/uilet/tree/main/packages/artifact-kit#readme",
  "bugs": {
    "url": "https://github.com/crewlet/uilet/issues"
  },
  "type": "module",
  "sideEffects": true,
  "exports": {
    "./kit.css": "./dist/kit.css",
    "./content.css": "./dist/content.css",
    "./kit.js": "./dist/kit.js",
    "./theme.js": "./dist/theme.js",
    "./fonts/*": "./dist/fonts/*",
    "./THIRD_PARTY_NOTICES.txt": "./dist/THIRD_PARTY_NOTICES.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint scripts src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@crewlethq/icons": "0.2.0",
    "@crewlethq/tokens": "0.2.0",
    "@crewlethq/ui": "0.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
