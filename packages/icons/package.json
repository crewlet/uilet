{
  "name": "@crewlethq/icons",
  "version": "0.2.0",
  "description": "Crewlet signature illustrated icons, vendor marks, and the Lucide glyph set as React components.",
  "license": "MIT AND ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewlet/uilet.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/crewlet/uilet/tree/main/packages/icons#readme",
  "bugs": {
    "url": "https://github.com/crewlet/uilet/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./glyphs": {
      "types": "./dist/glyphs.d.ts",
      "import": "./dist/glyphs.js"
    },
    "./glyphs/registry": {
      "types": "./dist/glyphs-registry.d.ts",
      "import": "./dist/glyphs-registry.js"
    },
    "./characters": {
      "types": "./dist/characters.d.ts",
      "import": "./dist/characters.js"
    },
    "./favicon/*": "./favicon/*",
    "./glyphs/*": "./glyphs/*",
    "./svg/*": "./svg/*"
  },
  "files": [
    "dist",
    "favicon",
    "glyphs",
    "svg",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsup",
    "dev": "node scripts/build.mjs && tsup --watch",
    "lint": "node scripts/build.mjs && eslint src scripts test",
    "typecheck": "node scripts/build.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node --import ./test/css-stub.mjs --test \"test/*.test.mjs\"",
    "vendor-glyphs": "node scripts/vendor-glyphs.mjs",
    "clean": "rm -rf dist src/generated"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.2.3",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
