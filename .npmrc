# engine-strict is deliberately not set. The root "engines" field still
# declares the supported Node and npm warns on a mismatch, but engine-strict
# would turn that warning into a refusal for Dependabot, which installs with
# its own Node, and its update pull requests would silently stop opening.
# .nvmrc is the version contributors and CI actually run.

# Third-party dependencies are saved as ranges and package-lock.json pins what
# is installed. Dependencies between workspaces are pinned to the release
# version exactly by scripts/release.mjs, which CI enforces.
save-exact=false
